# HayPahest (ՀայՊահեստ) — Backend Configuration

# Application
APP_NAME="HayPahest API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="haypahest-super-secret-jwt-key-change-in-production-amen"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For local development with PostgreSQL:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/haypahest_db"
# Or synchronous URL for migrations & standard sessions:
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/haypahest_db"

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://ais-dev-2vefnwh6sbhupf73zemvex-488688915515.europe-west3.run.app","https://ais-pre-2vefnwh6sbhupf73zemvex-488688915515.europe-west3.run.app"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
